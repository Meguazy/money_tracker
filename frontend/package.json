{
  "name": "money-tracker-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build",
    "dev": "vite --host 127.0.0.1",
    "test:e2e": "NODE_PATH=./node_modules playwright test --config playwright.config.ts",
    "test:e2e:ci": "NODE_PATH=./node_modules playwright test --config playwright.config.ts --grep-invert @local-model",
    "test:e2e:installed": "NODE_PATH=./node_modules playwright test --config playwright.installed.config.ts",
    "test": "vitest run",
    "test:ci": "vitest run --reporter=default --reporter=junit --outputFile=test-results/vitest-junit.xml",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@mantine/core": "^9.6.1",
    "@mantine/hooks": "^9.6.1",
    "@tanstack/react-query": "^5.103.1",
    "echarts": "^6.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
