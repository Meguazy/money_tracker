# Generate a ready-to-use version with: ./scripts/generate_local_env.sh

# Local OpenAI-compatible inference server.
LLM_BASE_URL=http://localhost:8080/v1
LLM_API_KEY=local
LLM_MODEL=local-model
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=120

# Local Langfuse SDK configuration.
LANGFUSE_BASE_URL=http://localhost:3000
LANGFUSE_PUBLIC_KEY=pk-lf-replace-me
LANGFUSE_SECRET_KEY=sk-lf-replace-me
LANGFUSE_TRACING_ENVIRONMENT=development

# Local Langfuse bootstrap account.
LANGFUSE_INIT_USER_EMAIL=admin@money-tracker.local
LANGFUSE_INIT_USER_NAME=Local-Admin
LANGFUSE_INIT_USER_PASSWORD=replace-me

# Compose service secrets. Replace every value or run the generator.
LANGFUSE_NEXTAUTH_SECRET=replace-me
LANGFUSE_SALT=replace-me
LANGFUSE_ENCRYPTION_KEY=replace-with-64-hex-characters
LANGFUSE_POSTGRES_PASSWORD=replace-me
LANGFUSE_CLICKHOUSE_PASSWORD=replace-me
LANGFUSE_REDIS_PASSWORD=replace-me
LANGFUSE_MINIO_PASSWORD=replace-me

# Dedicated application PostgreSQL. The application credential is intentionally
# distinct from the container initialization administrator credential.
MONEY_TRACKER_POSTGRES_ADMIN_PASSWORD=replace-me
MONEY_TRACKER_POSTGRES_PASSWORD=replace-me
MONEY_TRACKER_DATABASE_URL=postgresql://money_tracker:replace-me@127.0.0.1:5433/money_tracker
MONEY_TRACKER_TEST_DATABASE_URL=postgresql://money_tracker:replace-me@127.0.0.1:5433/money_tracker_test

# Restrict checkpoint deserialization if the database is compromised.
LANGGRAPH_STRICT_MSGPACK=true

# Used by scripts/run_llama_server.sh, not by the Python application.
MODEL_PATH=/absolute/path/to/model.gguf
# Leave empty for text-only models; set to a matching projector for vision.
MMPROJ_PATH=
LLAMA_SERVER_BIN=llama-server
LLAMA_MODEL_ALIAS=local-model
LLAMA_CTX_SIZE=8192
LLAMA_PARALLEL=1
LLAMA_REASONING=off
