# Generate a ready-to-use version with: ./scripts/generate_local_env.sh

# Local OpenAI-compatible inference server.
LLM_BASE_URL=http://localhost:8080/v1
LLM_API_KEY=local
LLM_MODEL=local-model
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=120

# Local Langfuse SDK configuration.
LANGFUSE_BASE_URL=http://localhost:3000
LANGFUSE_PUBLIC_KEY=pk-lf-replace-me
LANGFUSE_SECRET_KEY=sk-lf-replace-me
LANGFUSE_TRACING_ENVIRONMENT=development
# Full-fidelity traces (AD-021) stay off until the operator switches them on.
MONEY_TRACKER_TRACING_ENABLED=false
MONEY_TRACKER_TRACING_EXPORT_TIMEOUT_SECONDS=2

# Local Langfuse bootstrap account.
LANGFUSE_INIT_USER_EMAIL=admin@money-tracker.local
LANGFUSE_INIT_USER_NAME=Local-Admin
LANGFUSE_INIT_USER_PASSWORD=replace-me

# Compose service secrets. Replace every value or run the generator.
LANGFUSE_NEXTAUTH_SECRET=replace-me
LANGFUSE_SALT=replace-me
LANGFUSE_ENCRYPTION_KEY=replace-with-64-hex-characters
LANGFUSE_POSTGRES_PASSWORD=replace-me
LANGFUSE_CLICKHOUSE_PASSWORD=replace-me
LANGFUSE_REDIS_PASSWORD=replace-me
LANGFUSE_MINIO_PASSWORD=replace-me

# Dedicated application PostgreSQL. The application credential is intentionally
# distinct from the container initialization administrator credential.
MONEY_TRACKER_POSTGRES_ADMIN_PASSWORD=replace-me
MONEY_TRACKER_POSTGRES_PASSWORD=replace-me
MONEY_TRACKER_DATABASE_URL=postgresql://money_tracker:replace-me@127.0.0.1:5433/money_tracker
MONEY_TRACKER_TEST_DATABASE_URL=postgresql://money_tracker:replace-me@127.0.0.1:5433/money_tracker_test
MONEY_TRACKER_RECEIPT_ARCHIVE_ROOT=/home/replace-me/.local/share/money-tracker/receipts

# Local same-origin API and compiled dashboard.
MONEY_TRACKER_WEB_HOST=127.0.0.1
MONEY_TRACKER_WEB_PORT=8000
MONEY_TRACKER_WEB_ALLOWED_HOSTS=127.0.0.1,localhost
MONEY_TRACKER_WEB_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
MONEY_TRACKER_WEB_STATIC_DIR=/absolute/path/to/money-tracker/frontend/dist

# Encrypted authoritative backup. Select an external repository and create the
# password file as mode 600; keep a second password copy off this workstation.
MONEY_TRACKER_BACKUP_EXPECTED_DATABASE=money_tracker
MONEY_TRACKER_BACKUP_CONFIG_FILE=/absolute/path/to/money-tracker/.env
MONEY_TRACKER_RESTIC_REPOSITORY=/absolute/path/to/external/money-tracker-restic
MONEY_TRACKER_RESTIC_PASSWORD_FILE=/home/replace-me/.config/money-tracker/restic-password
MONEY_TRACKER_BACKUP_LOCK_FILE=/home/replace-me/.local/state/money-tracker/backup.lock
MONEY_TRACKER_BACKUP_STAGING_PARENT=/home/replace-me/.cache/money-tracker/backup-staging
MONEY_TRACKER_RESTIC_BINARY=/usr/bin/restic
MONEY_TRACKER_PG_DUMP_BINARY=/usr/lib/postgresql/17/bin/pg_dump
MONEY_TRACKER_PG_RESTORE_BINARY=/usr/lib/postgresql/17/bin/pg_restore

# Restrict checkpoint deserialization if the database is compromised.
LANGGRAPH_STRICT_MSGPACK=true

# Structured application logging. Every process writes one JSON object per line
# to standard error, which keeps machine-readable command output on standard
# out usable in a pipeline. Use LOG_FORMAT=text when reading a terminal, and
# LOG_LEVEL=DEBUG to add the per-step records the default level omits.
LOG_LEVEL=INFO
LOG_FORMAT=json

# Used by scripts/run_llama_server.sh, not by the Python application.
# Installed weights live outside the repository. The documented layout is
# ~/.local/share/money-tracker/models/{text,vision,shared}/<profile>/, one
# directory per screened candidate; see docs/development.md.
MODEL_PATH=/home/replace-me/.local/share/money-tracker/models/text/<profile>/<weights>.gguf
# Leave empty for text-only models; set to a matching projector for vision.
MMPROJ_PATH=
LLAMA_SERVER_BIN=llama-server
LLAMA_MODEL_ALIAS=local-model
LLAMA_CTX_SIZE=8192
LLAMA_PARALLEL=1
LLAMA_REASONING=off
