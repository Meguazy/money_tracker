[Unit]
Description=Money Tracker Telegram gateway
Documentation=file://__MONEY_TRACKER_ROOT__/docs/operations/telegram.md
# The application database runs in Docker, which a user unit cannot order
# itself against. Recovery is handled by restarting on a dependency exit code
# instead, so a workstation that starts Docker late converges without help.
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=__MONEY_TRACKER_ROOT__
EnvironmentFile=__MONEY_TRACKER_ROOT__/.env
ExecStart=__MONEY_TRACKER_ROOT__/.venv/bin/money-tracker-telegram run
Restart=always
RestartSec=10
# Exit code 1 means an operator has to change something. Restarting would
# repeat the same failure forever and bury it in the journal.
RestartPreventExitStatus=1
KillSignal=SIGINT
TimeoutStopSec=30
# Every directive below is one a user manager can actually apply. Dropping
# bounding-set capabilities needs CAP_SETPCAP, which an unprivileged user
# manager does not have, so CapabilityBoundingSet=, PrivateDevices=,
# ProtectClock=, ProtectKernelLogs=, and ProtectKernelModules= make the unit
# fail to execute with 218/CAPABILITIES rather than hardening it. They are
# deliberately absent; do not reintroduce them without moving to a system
# unit. `systemd-analyze verify` and `security` both score a unit's
# configuration and cannot catch this, so a change here has to be started.
NoNewPrivileges=true
UMask=0077
LockPersonality=true
PrivateTmp=true
ProtectControlGroups=true
ProtectHome=read-only
ProtectKernelTunables=true
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native

[Install]
WantedBy=default.target
