[Unit]
Description=Money Tracker local llama.cpp inference server
Documentation=file://%h/money-tracker/docs/operations/local-runtime.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=__MONEY_TRACKER_ROOT__
# The launcher reads the shell environment rather than .env, so the unit
# supplies it. Its own exit code 2 already means "operator must fix the model
# configuration", which matches the convention the Python entry points use.
EnvironmentFile=__MONEY_TRACKER_ROOT__/.env
ExecStart=__MONEY_TRACKER_ROOT__/scripts/run_llama_server.sh
Restart=always
RestartSec=15
RestartPreventExitStatus=2
KillSignal=SIGINT
TimeoutStopSec=30
NoNewPrivileges=true

[Install]
WantedBy=default.target
