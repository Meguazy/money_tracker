{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(gh pr merge *)",
      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push *:main)",
      "Bash(git push *:main *)",
      "Bash(git push *+main)",
      "Bash(git push *+main *)",
      "Bash(git push *refs/heads/main)",
      "Bash(git push *refs/heads/main *)",
      "Bash(git commit *--no-verify*)",
      "Bash(git commit -n*)",
      "Bash(git commit * -n)",
      "Bash(git commit * -n *)",
      "Bash(git push *--no-verify*)",
      "Bash(git push -n*)",
      "Bash(git push * -n)",
      "Bash(git push * -n *)",
      "Bash(gh api -*rulesets*)",
      "Bash(gh api *rulesets* -*)",
      "Bash(gh api -*branches/*/protection*)",
      "Bash(gh api *branches/*/protection* -*)",
      "Bash(gh api graphql *RepositoryRuleset*)",
      "Bash(gh api graphql *BranchProtectionRule*)",
      "Bash(git config *core.hooksPath*)",
      "Bash(gh repo edit *)",
      "Bash(gh repo delete *)",
      "Bash(cat *.env*)",
      "Bash(head *.env*)",
      "Bash(tail *.env*)",
      "Bash(less *.env*)",
      "Bash(more *.env*)",
      "Bash(sed *.env*)",
      "Bash(awk *.env*)",
      "Bash(grep *.env*)",
      "Bash(rg *.env*)",
      "Read(.env)",
      "Read(.env.acceptance)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --project \"$CLAUDE_PROJECT_DIR\" money-tracker-guard-claude-bash",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  }
}
