[Unit]
Description=Money Tracker sequential workflow worker
Documentation=file://__MONEY_TRACKER_ROOT__/docs/operations/telegram.md
# Deliberately not ordered after the gateway. The two have separate failure
# domains: the gateway must keep accepting Telegram updates while this side is
# down, and this side must keep draining the durable inbox while the gateway
# is down.
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=__MONEY_TRACKER_ROOT__
EnvironmentFile=__MONEY_TRACKER_ROOT__/.env
# Tracing names the serving llama.cpp executable by digest. `LLAMA_SERVER_BIN`
# is a bare name resolved through ~/.local/bin, which a lingering user manager
# lacks on PATH before any login session, so the identity would be incomplete
# after an unattended boot. See the llama unit.
Environment=PATH=%h/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# Private writable cache of model artifact digests, so a restart never hashes
# the ten-gigabyte weights again. It stays writable when the home becomes
# read-only. See docs/operations/tracing.md.
CacheDirectory=money-tracker
CacheDirectoryMode=0700
ExecStart=__MONEY_TRACKER_ROOT__/.venv/bin/money-tracker-worker run
Restart=always
RestartSec=10
RestartPreventExitStatus=1
KillSignal=SIGINT
TimeoutStopSec=60
# See the gateway unit: capability-dropping directives cannot be applied by an
# unprivileged user manager and stop the unit with 218/CAPABILITIES instead of
# hardening it. Only directives a user manager can enforce appear here.
NoNewPrivileges=true
UMask=0077
LockPersonality=true
PrivateTmp=true
ProtectControlGroups=true
ProtectHome=read-only
ProtectKernelTunables=true
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native

[Install]
WantedBy=default.target
