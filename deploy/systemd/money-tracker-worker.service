[Unit]
Description=Money Tracker sequential workflow worker
Documentation=file://__MONEY_TRACKER_ROOT__/docs/operations/telegram.md
# Deliberately not ordered after the gateway. The two have separate failure
# domains: the gateway must keep accepting Telegram updates while this side is
# down, and this side must keep draining the durable inbox while the gateway
# is down.
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=__MONEY_TRACKER_ROOT__
EnvironmentFile=__MONEY_TRACKER_ROOT__/.env
ExecStart=__MONEY_TRACKER_ROOT__/.venv/bin/money-tracker-worker run
Restart=always
RestartSec=10
RestartPreventExitStatus=1
KillSignal=SIGINT
TimeoutStopSec=60
# See the gateway unit: capability-dropping directives cannot be applied by an
# unprivileged user manager and stop the unit with 218/CAPABILITIES instead of
# hardening it. Only directives a user manager can enforce appear here.
NoNewPrivileges=true
UMask=0077
LockPersonality=true
PrivateTmp=true
ProtectControlGroups=true
ProtectHome=read-only
ProtectKernelTunables=true
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native

[Install]
WantedBy=default.target
